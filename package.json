{
  "name": "did-you-hear-that",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright install chromium && npm run build && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:copy": "tsx tools/check-copy.ts",
    "render:sounds": "tsx tools/render-sounds.ts",
    "experiment:properties": "tsx tests/properties/checks/run-brief-properties.ts",
    "experiment:scatter": "tsx tests/listeners/write-scatter-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
